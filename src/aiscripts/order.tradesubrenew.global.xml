<?xml version="1.0" encoding="utf-8"?>
<aiscript name="order.tradesubrenew.global" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="aiscripts.xsd" version="1">
  <order id="TradeSubRenewGlobal" name="{989831, 1}" description="{989831, 2}" category="trade" allowinloop="false" infinite="true">
    <params>
      <param name="idletime" type="time" default="5min" text="{989831, 3}" comment="Time to wait when no station needs an update.">
        <input_param name="min" value="1min"/>
        <input_param name="max" value="1h"/>
        <input_param name="step" value="1min"/>
      </param>
      <param name="useparking" type="bool" default="false" text="{989831, 14}" comment="Return to a selected sector when no station needs an update."/>
      <param name="parkingsector" type="object" default="this.ship.sector" text="{989831, 18}" comment="Sector used when Parking sector is enabled.">
        <input_param name="class" value="class.sector"/>
      </param>
    </params>
    <skill min="80"/>
    <requires>
      <match shiptype="shiptype.lasertower" negate="true"/>
      <match class="class.spacesuit" negate="true"/>
    </requires>
  </order>

  <interrupts>
    <handler ref="SectorChangeHandler"/>
    <handler ref="TargetInvalidHandler"/>
    <handler ref="AttackHandler"/>
    <handler ref="MissileLockHandler"/>
    <handler ref="ScannedHandler"/>
    <handler ref="InspectedHandler"/>
    <handler ref="FoundAbandonedHandler"/>
    <handler ref="FoundLockboxHandler"/>
    <handler ref="ResupplyHandler"/>
  </interrupts>

  <attention min="unknown">
    <actions>
      <set_value name="$ship" exact="this.assignedcontrolled"/>
      <set_order_syncpoint_reached order="$ship.order"/>
      <run_script name="'lib.tradesubrenew.routine'">
        <param name="idletime" value="$idletime"/>
        <param name="useparking" value="$useparking"/>
        <param name="parkingsector" value="$parkingsector"/>
        <param name="xpcategory" value="'tradesub_renew_global'"/>
        <param name="xpfactor" value="if $ship.combinedskill ge 90 then 0.35 else 1.0"/>
      </run_script>
    </actions>
  </attention>
</aiscript>
